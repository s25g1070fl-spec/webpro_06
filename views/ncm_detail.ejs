<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %> の詳細</title>
</head>
<body>
  <h1><%= data.name %> の詳細</h1>

  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>サイト名</td><td><%= data.name %></td></tr>
    <tr><td>URL</td><td><a href="<%= data.url %>" target="_blank"><%= data.url %></a></td></tr>
    <tr><td>商用利用</td><td><%= data.commercialUse %></td></tr>
    <tr><td>クレジット表記</td><td><%= data.credit %></td></tr>
    <tr><td>概要</td><td><%= data.summary %></td></tr>
  </table>

  <hr>

  <a href="/ncm/edit/<%= id %>">このサイトの情報を編集する</a>
  <br>
  <a href="/ncm/deleteCheck/<%= id %>">このサイトの情報を削除する</a>
  <br>
  <br>
  <a href="/ncm">BGMサイト一覧に戻る</a>

</body>
</html>