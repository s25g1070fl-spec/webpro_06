<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %> の詳細</title>
</head>
<body>
  <h1><%= data.name %></h1>

  <table border="1">
    <tr>
      <th style="width: 20%;">項目</th>
      <th>データ</th>
    </tr>
    <tr>
      <td>原則名</td>
      <td><%= data.name %></td>
    </tr>
    <tr>
      <td>概要</td>
      <td><%= data.summary %></td>
    </tr>
  </table>

  <hr>

  <a href="/animation/edit/<%= id %>">この原則の情報を編集する</a>
  <br>
  <a href="/animation/deleteCheck/<%= id %>">この原則の情報を削除する</a>
  <br>
  <br>
  <a href="/animation">原則一覧に戻る</a>

</body>
</html>