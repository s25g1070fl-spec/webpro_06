<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %> の編集</title>
</head>
<body>
  <h1><%= data.name %> の情報を編集</h1>

  <form action="/ncm/update/<%= id %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr>
        <td>サイト名</td>
        <td><input type="text" name="name" value="<%= data.name %>" size="50"></td>
      </tr>
      <tr>
        <td>URL</td>
        <td><input type="text" name="url" value="<%= data.url %>" size="50"></td>
      </tr>
      <tr>
        <td>商用利用</td>
        <td><input type="text" name="commercialUse" value="<%= data.commercialUse %>" size="50"></td>
      </tr>
      <tr>
        <td>クレジット表記</td>
        <td><input type="text" name="credit" value="<%= data.credit %>" size="50"></td>
      </tr>
      <tr>
        <td>概要</td>
        <td><textarea name="summary" rows="4" cols="50"><%= data.summary %></textarea></td>
      </tr>
    </table>
    <br>
    <button type="submit">更新する</button>
  </form>

  <br>
  <a href="/ncm/<%= id %>">キャンセルして詳細に戻る</a>

</body>
</html>