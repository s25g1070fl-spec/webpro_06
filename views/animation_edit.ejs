<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %> の編集</title>
</head>
<body>
  <h1><%= data.name %> の情報を編集</h1>

  <form action="/animation/update/<%= id %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr>
        <td>原則名</td>
        <td><input type="text" name="name" value="<%= data.name %>" size="50"></td>
      </tr>
      <tr>
        <td>概要</td>
        <td><textarea name="summary" rows="4" cols="50"><%= data.summary %></textarea></td>
      </tr>
      <tr>
        <td>参考URL</td>
        <td><input type="text" name="exampleUrl" value="<%= data.exampleUrl %>" size="50"></td>
      </tr>
    </table>
    <br>
    <button type="submit">更新する</button>
  </form>

  <br>
  <a href="/animation/<%= id %>">詳細に戻る</a>

</body>
</html>