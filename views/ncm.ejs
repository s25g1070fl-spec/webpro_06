<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>BGMサイトまとめ</title>
</head>
<body>
  <h1>BGMサイトまとめ</h1>
  <p>おすすめの著作権フリーBGM・効果音サイトの一覧です。</p>

  <table border="1"> <!-- border="1" を追加して枠線を表示 -->
    <thead>
      <tr>
        <th>サイト名</th>
        <th>商用利用</th>
        <th>クレジット表記</th>
      </tr>
    </thead>
    <tbody>
      <% for( let i = 0; i < data.length; i++ ) { %>
        <% let row = data[i]; %>
        <tr>
          <td><a href="/ncm/<%= i %>"><%= row.name %></a></td>
          <td><%= row.commercialUse %></td>
          <td><%= row.credit %></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <br>
  <a href="/ncm/create">新しいサイトを追加する</a>

</body>
</html>