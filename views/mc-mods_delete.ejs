<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %> の削除確認</title>
</head>
<body>
  <h1>削除確認</h1>
  <h2>MOD「<%= data.name %>」を本当に削除しますか？</h2>
  <p>この操作は元に戻せません。</p>

  <h3>削除するデータの内容</h3>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>MOD名</td><td><%= data.name %></td></tr>
    <tr><td>URL</td><td><%= data.url %></td></tr>
    <tr><td>対応バージョン</td><td><%= data.version %></td></tr>
    <tr><td>前提MOD/Loader</td><td><%= data.loader %></td></tr>
    <tr><td>概要</td><td><%= data.summary %></td></tr>
  </table>

  <hr>

  <!-- 削除を実行するためのフォーム -->
  <form action="/mc-mods/delete/<%= id %>" method="POST">
    <button type="submit">削除</button>
  </form>

  <br>

  <!-- キャンセルして詳細ページに戻るためのリンク -->
  <a href="/mc-mods/<%= id %>">キャンセル</a>

</body>
</html>